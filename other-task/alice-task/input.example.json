{
  "version": 1,
  "assignment": {
    "profileSource": "env",
    "strategy": "perBrowserSequential",
    "tasksPerBrowser": 2
  },
  "variables": {
    "aShareStockName": {
      "type": "randomChoice",
      "source": "builtin:a_share_stock_names",
      "uniquePerRun": true
    },
    "futuresProductName": {
      "type": "randomChoice",
      "source": "builtin:futures_product_names",
      "uniquePerRun": true
    }
  },
  "taskTemplates": [
    {
      "name": "stock-analysis",
      "skillNumber": 2,
      "prompt": "请分析A股股票：{{aShareStockName}}。"
    },
    {
      "name": "futures-analysis",
      "skillNumber": 1,
      "prompt": "请分析期货品种：{{futuresProductName}}。"
    }
  ]
}
