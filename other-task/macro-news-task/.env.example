# LLM API 配置
# 支持 VolcEngine (豆包)、OpenAI、DeepSeek 或任何 OpenAI 兼容接口

# === VolcEngine (豆包) ===
# LLM_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
# LLM_API_KEY=your-volcengine-api-key
# LLM_MODEL=doubao-pro-32k

# === OpenAI ===
# LLM_ENDPOINT=https://api.openai.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o

# === DeepSeek ===
# LLM_ENDPOINT=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-chat

# === 通用配置 ===
LLM_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=doubao-pro-32k
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
